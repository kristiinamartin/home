<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{% if pageTitle %}{{ pageTitle }}{% else %}{{ title }} | {{ site.name }}{% endif %}</title>
  <meta name="description" content="{{ description or site.headline }}">
  <meta name="color-scheme" content="light dark">
  <meta property="og:title" content="{% if pageTitle %}{{ pageTitle }}{% else %}{{ title }} | {{ site.name }}{% endif %}">
  <meta property="og:description" content="{{ description or site.headline }}">
  <meta property="og:type" content="website">
  <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Crect width='32' height='32' rx='6' fill='%231f4e79'/%3E%3Ctext x='16' y='22' font-family='Arial,sans-serif' font-size='15' font-weight='700' text-anchor='middle' fill='white'%3EKM%3C/text%3E%3C/svg%3E">
  <script>document.documentElement.classList.add("js");</script>
  <link rel="stylesheet" href="{{ '/assets/styles.css' | url }}">
</head>
<body>
  <a class="skip" href="#main">Skip to content</a>

  <div class="shell">
    <aside class="rail">
      <div class="rail-id">
        <p class="rail-name"><a href="{{ '/' | url }}">{{ site.name }}</a></p>
        <p class="rail-role">{{ roles[0].title }}, {{ roles[0].org }}</p>
      </div>
      <nav class="rail-nav" aria-label="Pages">
        {%- for item in nav %}
        <a href="{{ item.url | url }}"{% if item.url == page.url %} aria-current="page"{% endif %}>{{ item.title }}</a>
        {%- endfor %}
      </nav>
      <ul class="rail-links">
        {%- for l in site.links %}
        <li><a href="{{ l.url }}" rel="noopener">{{ l.label }}</a></li>
        {%- endfor %}
      </ul>
    </aside>

    <main id="main">
      {{ content | safe }}
      <footer class="foot">
        <p>&copy; {{ buildYear }} {{ site.name }}. {{ site.location }}.</p>
      </footer>
    </main>
  </div>

  <script src="{{ '/assets/site.js' | url }}" defer></script>
</body>
</html>
